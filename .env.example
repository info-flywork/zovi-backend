NODE_ENV=development
PORT=3000

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Firebase Admin — path to service account JSON from Firebase Console
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./zovi-7a4a7-firebase-adminsdk-fbsvc-4ceae3a02d.json

LOG_LEVEL=info

# Bunny.net Storage + CDN (avatars)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_HOST=
BUNNY_STORAGE_HOST=

# OpenAI — sticker generation + mock chat (LLM + TTS voice notes)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ElevenLabs TTS for mock voice notes
# Voice IDs are assigned per mock user in DB (npm run seed:mock-voices)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Suno API (https://sunoapi.org) — catalog seed via npm run seed:suno
SUNO_API_KEY=
SUNO_CALLBACK_URL=https://example.com/music/suno/callback

# OneSignal (push) — REST key stays server-side only
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_REST_API_KEY=

# Google Places API (New) — Nearby Search for plan/check-in places
GOOGLE_PLACES_API_KEY=

# RevenueCat webhook Authorization header value
# Dashboard → Project → Integrations → Webhooks
# URL: https://zovi.fly-work.com/billing/revenuecat/webhook
# Authorization: Bearer <same value as below>
REVENUECAT_WEBHOOK_AUTH=

# Android App Links: app-signing SHA-256 fingerprint(s), comma-separated.
# Release: Play Console → App signing → SHA-256. Debug keystore fingerprint can
# be added too. Served at /.well-known/assetlinks.json.
ANDROID_CERT_SHA256=
